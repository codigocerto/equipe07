generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id                     String           @id @default(uuid())
  name                   String       
  email                  String           @unique 
  phone                  String           @db.VarChar(11)
  technologies           Candidate_Technologies[]
  contributionType       Contribution     @default(APPRENTICE)
  isSignIn               Boolean          
  createdAt              DateTime         @default(now())
}

model Candidate_Technologies {
  id                     String           @id @default(uuid())
  candidate              Candidate        @relation(fields: [candidateId], references: [id])
  candidateId            String
  technology              Technologies        @relation(fields: [technologyId], references: [id])
  technologyId            String

  @@index([candidateId])
  @@index([technologyId])
}

model Technologies {
  id                     String           @id @default(uuid())
  level                  Level            @default(STARTER)
  name                   String           @unique
  
  candidates             Candidate_Technologies[]
}

enum Contribution {
  APPRENTICE
  MENTOR
  COLLABORATOR
}

enum Level {
  STARTER
  MIDLEVEL
  ADVANCED
}